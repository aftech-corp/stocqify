# ── Credentials & local overrides ────────────────────────────
# Never commit real credentials. Use *.sample.php as the template.
app/config/database.php
app/config/config.local.php

# ── User uploaded files ───────────────────────────────────────
# These are generated at runtime — not part of source code
uploads/
public/uploads/

# ── Database dumps ────────────────────────────────────────────
# Keep database/schema.sql and database/seed.sql; ignore all other SQL dumps
/database/dump_*.sql
/database/backup_*.sql
/*.sql

# ── Environment / secrets ─────────────────────────────────────
.env
.env.local
*.env

# ── Claude Code internal files ────────────────────────────
.claude/

# ── OS / editor junk ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# ── PHP runtime ───────────────────────────────────────────────
*.log
/var/
